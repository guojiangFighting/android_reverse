<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@id/three_layout" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <com.huawei.uikit.phone.hwimageview.widget.HwImageView android:id="@id/background_image" android:layout_width="match_parent" android:layout_height="wrap_content" android:scaleType="centerCrop" />
    <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textColor="#d6ffffff" android:gravity="center_vertical" android:id="@id/this_test_drive" android:layout_width="wrap_content" android:layout_height="@dimen/font40" android:layout_marginTop="@dimen/dp_104" android:text="@string/xcar_app_text_this_test_drive" android:layout_marginStart="@dimen/font32" style="@style/textColorPrimaryAndSizeBody1AndFamilyRegular" />
    <LinearLayout android:id="@id/driving_kilometers_lay" android:layout_width="wrap_content" android:layout_height="@dimen/font40" android:layout_below="@id/this_test_drive" android:layout_marginStart="@dimen/font32">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textColor="#d6ffffff" android:id="@id/travels_id" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/xcar_app_text_drive" style="@style/textColorPrimaryAndSizeBody1AndFamilyRegular" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textSize="@dimen/hwlistpattern_text_size_24" android:textStyle="bold" android:textColor="#ffffff" android:id="@id/driving_kilometers_time_id" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/font8" />
    </LinearLayout>
    <LinearLayout android:id="@id/average_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/driving_kilometers_lay" android:layout_marginStart="@dimen/font32">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textColor="#d6ffffff" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="@dimen/font40" android:text="@string/xcar_app_text_hundred_kilometer" style="@style/textColorPrimaryAndSizeBody1AndFamilyRegular" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textColor="#d6ffffff" android:gravity="center_vertical" android:id="@id/average_power_consumption_id" android:layout_width="wrap_content" android:layout_height="@dimen/font40" style="@style/textColorPrimaryAndSizeBody1AndFamilyRegular" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textColor="#d6ffffff" android:gravity="center_vertical" android:id="@id/average_fuel_consumption_id" android:layout_width="wrap_content" android:layout_height="@dimen/font40" style="@style/textColorPrimaryAndSizeBody1AndFamilyRegular" />
    </LinearLayout>
    <RelativeLayout android:id="@id/annual_savings_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/average_layout">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textColor="#d6ffffff" android:gravity="center_vertical" android:id="@id/savings_message_id" android:layout_width="@dimen/baseui_dp_138" android:layout_height="wrap_content" android:layout_marginStart="@dimen/font32" style="@style/textColorPrimaryAndSizeBody1AndFamilyRegular" />
        <LinearLayout android:id="@id/linear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_toEndOf="@id/savings_message_id">
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textSize="@dimen/hwlistpattern_item_margin_28" android:textStyle="bold" android:textColor="#ffffff" android:id="@id/savings_id" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/font8" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textSize="@dimen/baseui_fontsize_body_16" android:textColor="#d6ffffff" android:id="@id/money_unit_id" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/textColorPrimaryAndSizeBody1AndFamilyRegular" />
        </LinearLayout>
        <com.huawei.uikit.phone.hwimageview.widget.HwImageView android:id="@id/fee_description_id" android:layout_width="@dimen/font12" android:layout_height="@dimen/font12" android:src="@drawable/ic_public_note_white" android:scaleType="centerCrop" android:layout_marginStart="@dimen/font2" android:layout_toEndOf="@id/linear" />
    </RelativeLayout>
    <LinearLayout android:orientation="horizontal" android:id="@id/layout_speed" android:paddingBottom="@dimen/dp_104" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:paddingStart="@dimen/font16" android:paddingEnd="@dimen/font16">
        <RelativeLayout android:orientation="vertical" android:layout_width="0.0dp" android:layout_height="match_parent" android:layout_weight="1.0">
            <View android:id="@id/line1" android:background="@color/white" android:layout_width="0.5dp" android:layout_height="@dimen/font32" android:layout_centerVertical="true" android:layout_alignParentEnd="true" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textSize="@dimen/sp_20" android:textStyle="bold" android:textColor="@color/white" android:id="@id/average_speed_id" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textColor="@color/white" android:id="@id/average_speed_tv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/font7" android:text="@string/xcar_app_text_test_drive_report_average_speed" android:layout_below="@id/average_speed_id" android:layout_centerHorizontal="true" style="@style/textColorAndTextSizeBody3AndFamilyRegular" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="0.0dp" android:layout_height="match_parent" android:layout_weight="1.0">
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textSize="@dimen/sp_20" android:textStyle="bold" android:textColor="@color/white" android:id="@id/top_speed_id" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textColor="@color/white" android:id="@id/top_speed_tv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/font7" android:text="@string/xcar_app_text_test_drive_report_top_speed" android:layout_below="@id/top_speed_id" android:layout_centerHorizontal="true" style="@style/textColorWhiteSixtyAndSizeButton3AndFontFamilyMedium" />
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:id="@id/layout_speed_center" android:paddingBottom="@dimen/dp_104" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:paddingStart="@dimen/font16" android:paddingEnd="@dimen/font16">
        <RelativeLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="1.0">
            <View android:background="@color/emui_white" android:layout_width="0.5dp" android:layout_height="@dimen/font32" android:layout_alignParentRight="true" android:layout_centerVertical="true" android:alpha="0.3" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textSize="@dimen/sp_20" android:textStyle="bold" android:textColor="@color/white" android:id="@id/average_speed_id_center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/font7" android:text="@string/xcar_app_text_test_drive_report_average_speed" android:layout_below="@id/average_speed_id_center" android:layout_centerHorizontal="true" style="@style/textColorAndTextSizeBody3AndFamilyRegular" />
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true">
        <com.huawei.uikit.phone.hwimageview.widget.HwImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/font12" android:layout_marginBottom="@dimen/font24" android:src="@drawable/ic_next_page" android:scaleType="centerCrop" android:layout_centerHorizontal="true" />
    </RelativeLayout>
</RelativeLayout>
