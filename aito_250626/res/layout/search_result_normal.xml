<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <Space android:id="@id/space" android:layout_width="match_parent" android:layout_height="@dimen/search_result_item_margin" />
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@id/container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/search_result_item_margin" android:layout_below="@id/space">
        <com.huawei.uikit.phone.hwimageview.widget.HwImageView android:id="@id/image" android:layout_width="@dimen/search_result_image_width" android:layout_height="@dimen/search_result_image_width" android:src="@drawable/search_result_image_default_bg" />
        <RelativeLayout android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" android:layout_marginStart="@dimen/common_padding">
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textSize="@dimen/font14" android:ellipsize="end" android:id="@id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textSize="@dimen/font12" android:textColor="@color/search_result_subtitle_color" android:ellipsize="end" android:id="@id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/font4" android:maxLines="1" android:layout_below="@id/title" />
        </RelativeLayout>
    </LinearLayout>
    <View android:background="@drawable/ic_horizontal_driver_bg" android:layout_width="match_parent" android:layout_height="1.0px" android:layout_below="@id/container" />
</RelativeLayout>
