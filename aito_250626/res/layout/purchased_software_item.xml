<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="@dimen/font12" android:layout_marginEnd="@dimen/font12">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:ellipsize="end" android:id="@id/software_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/font16" android:maxLines="2" style="@style/textColorPrimaryAndSizeBody1AndFontFamilyMedium" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textColor="@color/new_emui_text_secondary" android:ellipsize="end" android:id="@id/software_validity_period" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/font8" android:maxLines="2" android:layout_below="@id/software_name" style="@style/textColorPrimaryAndSizeBody2AndFontFamilyRegular" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textColor="@color/new_emui_text_secondary" android:ellipsize="end" android:id="@id/software_validity_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/font4" android:layout_below="@id/software_validity_period" style="@style/textColorPrimaryAndSizeBody2AndFontFamilyRegular" />
