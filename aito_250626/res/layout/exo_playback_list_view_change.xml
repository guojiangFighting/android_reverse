<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:orientation="vertical" android:id="@id/simple_top" android:background="@android:color/transparent" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:id="@id/exo_controller_top" style="@style/ExoMediaTitleLayout">
        <com.huawei.uikit.phone.hwimageview.widget.HwImageView android:id="@id/exo_back" android:visibility="gone" android:layout_width="@dimen/font24" android:layout_height="@dimen/font24" android:src="@drawable/ic_back_white" android:layout_marginStart="@dimen/font12" />
    </LinearLayout>
    <LinearLayout android:id="@id/exo_controller_bottom" android:layout_alignParentBottom="true" style="@style/ExoMediaControllerBottom">
        <androidx.appcompat.widget.AppCompatCheckBox android:layout_gravity="center_vertical" android:id="@id/exo_video_volume" android:layout_marginStart="12.0dp" style="@style/ExoMediaButton.Volume" />
        <RelativeLayout android:layout_gravity="center_vertical" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0">
            <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress" android:visibility="gone" style="@style/ExoMediaTimeBar" />
            <TextView android:id="@id/exo_position" android:layout_below="@id/exo_progress" android:layout_marginStart="@dimen/font8" android:layout_marginEnd="@dimen/font16" android:layout_alignStart="@id/exo_progress" android:layout_alignParentEnd="true" style="@style/ExoMediaCurrPosition" />
            <TextView android:id="@id/exo_duration" android:visibility="gone" android:layout_below="@id/exo_progress" android:layout_alignEnd="@id/exo_progress" style="@style/ExoMediaDuration" />
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatCheckBox android:layout_gravity="center_vertical" android:id="@id/exo_video_fullscreen" android:layout_marginEnd="@dimen/font12" style="@style/ExoMediaButton.Fullscreen" />
    </LinearLayout>
    <com.huawei.uikit.phone.hwimageview.widget.HwImageView android:id="@id/exo_play" android:visibility="gone" android:src="@drawable/ic_exo_play" style="@style/ExoMediaButton.PlayList2" />
    <com.huawei.uikit.phone.hwimageview.widget.HwImageView android:id="@id/exo_pause" android:visibility="gone" android:src="@drawable/ic_exo_pause" style="@style/ExoMediaButton.PauseList2" />
</RelativeLayout>
