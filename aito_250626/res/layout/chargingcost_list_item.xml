<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:id="@id/root_view" android:visibility="visible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/font18" android:layout_marginBottom="@dimen/font18">
        <LinearLayout android:gravity="bottom" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:id="@id/real_total_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@string/emui_text_font_family_medium" style="@style/textColorPrimaryAndSizeBody1AndMedium" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:id="@id/original_total_price" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/font4" style="@style/textColorTertiaryAndSizeBody3NoMargin" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/xcar_app_text_unit_degrees" style="@style/textColorTertiaryAndSizeBody3NoMargin" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/font2">
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/xcar_app_text_electricity_price" android:layout_marginEnd="@dimen/font4" style="@style/textColorTertiaryAndSizeBody3NoMargin" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:id="@id/real_electricity_price" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/textColorTertiaryAndSizeBody3NoMargin" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:id="@id/original_electricity_price" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/font4" style="@style/textColorTertiaryAndSizeBody3NoMargin" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/xcar_app_text_unit_degrees" style="@style/textColorTertiaryAndSizeBody3NoMargin" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/font2">
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/xcar_app_text_service_charge" android:layout_marginEnd="@dimen/font4" style="@style/textColorTertiaryAndSizeBody3NoMargin" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:id="@id/real_service_price" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/textColorTertiaryAndSizeBody3NoMargin" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:id="@id/original_service_price" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/font4" style="@style/textColorTertiaryAndSizeBody3NoMargin" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:id="@id/charg_service_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/xcar_app_text_unit_degrees" style="@style/textColorTertiaryAndSizeBody3NoMargin" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:gravity="right" android:orientation="vertical" android:visibility="visible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textSize="@dimen/emui_text_size_body2" android:textColor="@color/emui_color_primary" android:id="@id/charging_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@string/emui_text_font_family_medium" />
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:id="@id/current_time" android:background="@drawable/charg_current_time" android:paddingLeft="@dimen/font4" android:paddingTop="@dimen/font1" android:paddingRight="@dimen/font4" android:paddingBottom="@dimen/font1" android:visibility="visible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/font2" android:text="@string/xcar_app_text_current_time_period" style="@style/textColorLinkAndSizeCaptionAndFamilyMedium" />
    </LinearLayout>
    <View android:id="@id/charging_bottom_line" android:background="#33000000" android:layout_width="match_parent" android:layout_height="@dimen/font_px_1" android:layout_below="@id/root_view" />
</RelativeLayout>
