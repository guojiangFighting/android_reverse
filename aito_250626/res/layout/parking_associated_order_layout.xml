    <LinearLayout android:orientation="horizontal" android:id="@id/expand_layout" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/parking_associated_order_item_margin" android:layout_below="@id/recycler_view" android:layout_alignParentEnd="true">
        <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:layout_gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/xcar_app_text_more" style="@style/textColorSecondaryAndSizeBody2AndFamilyRegular" />
