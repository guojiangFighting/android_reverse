                <app.huawei.auto.tangram.StrikeThruTextView android:textSize="@dimen/font14" android:textColor="@color/emui_color_secondary" android:id="@id/origin_price_text_view" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@string/emui_text_font_family_regular" android:layout_marginEnd="@dimen/font8" />
                <ImageView android:layout_gravity="center_vertical" android:id="@id/bonus_point_icon_view" android:layout_width="@dimen/font18" android:layout_height="@dimen/font18" android:src="@drawable/ic_bonus_point_icon" android:layout_marginEnd="@dimen/dp4" />
