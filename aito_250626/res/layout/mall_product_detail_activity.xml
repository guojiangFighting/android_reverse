            <include android:id="@id/mall_product_detail_cd_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/baseui_dp_72" layout="@layout/mall_product_detail_cd_view" />
            <com.huawei.uikit.phone.hwtextview.widget.HwTextView android:textSize="@dimen/sp_20" android:textColor="@color/emui_black" android:ellipsize="end" android:id="@id/product_name_text_view" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/font24" android:fontFamily="@string/emui_text_font_family_medium" android:layout_marginStart="@dimen/font16" android:layout_marginEnd="@dimen/font16" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@id/ll_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/font12" android:layout_marginStart="@dimen/font16" android:layout_marginEnd="@dimen/font16">
