            <app.huawei.auto.mall.views.MallServiceTitleContentView android:id="@id/mall_service_title_view" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <View android:background="#0d000000" android:layout_width="match_parent" android:layout_height="@dimen/font8" android:layout_marginBottom="@dimen/font8" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <app.huawei.auto.mall.views.MallProDetailCheckView android:layout_gravity="center" android:orientation="horizontal" android:id="@id/cl_bottom" android:background="@color/white" android:layout_width="match_parent" android:layout_height="@dimen/font72" android:layout_alignParentBottom="true" />
    <include android:id="@id/loadding_view" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" layout="@layout/xcar_poster_loadding_view" />
