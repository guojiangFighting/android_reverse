<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <corners android:radius="@dimen/font14" />
            <solid android:color="@color/color_blueness" />
        </shape>
    </item>
    <item android:state_checked="false">
        <shape>
            <corners android:radius="@dimen/font14" />
            <solid android:color="@color/color_line_f2f2f2" />
        </shape>
    </item>
</selector>
