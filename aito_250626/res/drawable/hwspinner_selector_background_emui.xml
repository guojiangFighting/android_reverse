<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/hwspinner_bg_hovered_or_pressed" />
    <item>
        <selector>
            <item android:state_focused="true" android:state_window_focused="true" android:drawable="@drawable/hwspinner_bg_focused" />
        </selector>
    </item>
    <item>
        <selector android:autoMirrored="true">
            <item android:state_enabled="false">
                <nine-patch android:src="@drawable/hwspinner_disabled_emui" android:tint="@color/emui_color_spinner_icon" />
            </item>
            <item android:state_pressed="true">
                <nine-patch android:src="@drawable/hwspinner_default_emui" android:tint="@color/emui_color_spinner_icon" />
            </item>
            <item android:state_focused="true" android:state_pressed="false">
                <nine-patch android:src="@drawable/hwspinner_default_emui" android:tint="@color/emui_color_spinner_icon" />
            </item>
            <item>
                <nine-patch android:src="@drawable/hwspinner_default_emui" android:tint="@color/emui_color_spinner_icon" />
            </item>
        </selector>
    </item>
</layer-list>
