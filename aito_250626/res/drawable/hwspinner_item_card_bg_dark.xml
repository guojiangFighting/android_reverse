<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="@dimen/hwspinner_bg_padding" android:right="@dimen/hwspinner_bg_padding">
        <selector android:enterFadeDuration="@integer/hwanimations_hover_animation_duration" android:exitFadeDuration="@integer/hwanimations_hover_animation_duration">
            <item android:drawable="@drawable/hwspinner_list_selector_background_selected_dark" android:state_activated="true" />
            <item android:state_checked="true" android:drawable="@drawable/hwspinner_list_selector_background_selected_dark" />
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>
    <item android:left="@dimen/hwspinner_bg_padding" android:right="@dimen/hwspinner_bg_padding">
        <selector>
            <item android:drawable="@android:color/transparent" android:state_activated="true" />
            <item android:state_checked="true" android:drawable="@android:color/transparent" />
            <item android:drawable="@drawable/hwspinner_list_selector_background_hovered_or_pressed_dark" />
        </selector>
    </item>
    <item android:left="@dimen/hwspinner_bg_padding" android:right="@dimen/hwspinner_bg_padding">
        <selector>
            <item android:state_focused="true" android:state_window_focused="true" android:drawable="@drawable/hwspinner_list_selector_background_focused_dark" />
            <item android:state_window_focused="true" android:state_selected="true" android:drawable="@drawable/hwspinner_list_selector_background_focused_dark" />
        </selector>
    </item>
</layer-list>
