<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill_horizontal|center" android:id="@android:id/background" android:drawable="@drawable/hwprogressbar_bg_emui" />
    <item android:gravity="fill_horizontal|center" android:id="@android:id/secondaryProgress">
        <scale android:scaleWidth="100%">
            <nine-patch android:src="@drawable/hwprogressbar_secondary_emui" android:tint="@color/color_35B949" />
        </scale>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <nine-patch android:src="@drawable/hwprogressbar_primary_emui" android:tint="@color/color_35B949" />
        </scale>
    </item>
</layer-list>
