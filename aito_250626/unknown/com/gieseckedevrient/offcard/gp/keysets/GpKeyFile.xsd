<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.gi-de.com/offcard/gpkeyfile/1.0"
        xmlns:ogpkf="http://www.gi-de.com/offcard/gpkeyfile/1.0"
        xmlns:oct="http://www.gi-de.com/offcard/commontypes/1.0"
        xmlns="http://www.w3.org/2001/XMLSchema"
        elementFormDefault="qualified">

  <import namespace="http://www.gi-de.com/offcard/commontypes/1.0" schemaLocation="../../CommonTypes.xsd"/>
  
  <element name="KeySets">
    <complexType>
      <choice minOccurs="0" maxOccurs="unbounded">
        <element name="GpSecureChannelBaseKeySet" type="ogpkf:GpSecureChannelBaseKeySetType"/>
        <element name="GpSecureChannelKeySet" type="ogpkf:GpSecureChannelKeySetType"/>
        <element name="GpSecureChannel03KeySet" type="ogpkf:GpSecureChannel03KeySetType"/>
        <element name="VisaSecureChannelKeySet" type="ogpkf:VisaSecureChannelKeySetType"/>
        <element name="GpDesDapVerificationKeySet" type="ogpkf:GpDesDapVerificationKeySetType"/>
        <element name="GpRsaDapVerificationKeySet" type="ogpkf:GpRsaDapVerificationKeySetType"/>
        <element name="GpRsaPrivateCrtKeySet" type="ogpkf:GpRsaPrivateCrtKeySetType"/>
        <element name="GpDelegatedManagementKeySet" type="ogpkf:GpDelegatedManagementKeySetType"/>
        <element name="GpDelegatedManagementDesKeySet" type="ogpkf:GpDelegatedManagementDesKeySetType"/>
        <element name="GpReceiptKeySet" type="ogpkf:GpReceiptKeySetType"/>
        <element name="GpGenericKeySet" type="ogpkf:GpGenericKeySetType"/>
        <element name="EtsiDesDapKeySet" type="ogpkf:EtsiDesDapKeySetType"/>
        <element name="OtaKeySet" type="ogpkf:OtaKeySetType"/>
        <element name="GpConfidentialLoadingKeySet" type="ogpkf:GpConfidentialLoadingKeySetType"/>
        <element name="GpAesConfidentialLoadingKeySet" type="ogpkf:GpAesConfidentialLoadingKeySetType"/>
        <element name="GpDataEncryptionKeySet" type="ogpkf:GpDataEncryptionKeySetType"/>
        <element name="GpAesDataEncryptionKeySet" type="ogpkf:GpAesDataEncryptionKeySetType"/>
        <element name="GpPskTlsKeySet" type="ogpkf:GpPskTlsKeySetType"/>
      </choice>
    </complexType>
  </element>

  <!-- Global Platform key set types -->

  <complexType name="GpSecureChannelBaseKeySetType">
    <sequence>
      <element name="SecureChannelBaseKey" type="ogpkf:GpDesEdeKeyType"/>
    </sequence>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
  </complexType>

  <complexType name="GpSecureChannelKeySetType">
    <sequence>
      <element name="SecureChannelEncKey" type="ogpkf:GpDesEdeKeyType"/>
      <element name="SecureChannelMacKey" type="ogpkf:GpDesEdeKeyType"/>
      <element name="DataEncryptionKey" type="ogpkf:GpDesEdeKeyType" minOccurs="0"/>
    </sequence>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
  </complexType>

  <complexType name="GpSecureChannel03KeySetType">
    <sequence>
      <element name="SecureChannelEncKey" type="ogpkf:GpAesKeyType"/>
      <element name="SecureChannelMacKey" type="ogpkf:GpAesKeyType"/>
      <element name="DataEncryptionKey" type="ogpkf:GpAesKeyType" minOccurs="0"/>
    </sequence>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
  </complexType>

  <complexType name="VisaSecureChannelKeySetType">
    <sequence>
      <element name="MasterKey" type="ogpkf:VisaSecretKeyType"/>
    </sequence>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
    <attribute name="DerivationKeyType" type="ogpkf:VisaMasterDerivationKeyTypeType" use="optional"/>
    <attribute name="Transformation" type="ogpkf:VisaMasterTransformationType" use="optional"/>
  </complexType>

  <complexType name="GpDesDapVerificationKeySetType">
    <sequence>
      <element name="DapVerificationKey" type="ogpkf:DesDapVerificationKeyType"/>
    </sequence>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
  </complexType>

  <complexType name="GpRsaDapVerificationKeySetType">
    <sequence>
      <element name="DapVerificationKey" type="ogpkf:GpRsaKeyType"/>
    </sequence>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
  </complexType>
  
  <complexType name="GpRsaPrivateCrtKeySetType">
    <sequence>
      <element name="RsaCrtKey" type="ogpkf:RsaCrtKeyType"/>
    </sequence>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
  </complexType>

  <complexType name="GpDelegatedManagementKeySetType">
    <sequence>
      <element name="DelegatedManagementKey" type="ogpkf:GpRsaKeyType"/>
      <element name="ReceiptKey" type="ogpkf:GpDesEdeKeyType" minOccurs="0"/>
    </sequence>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
  </complexType>
  
  <complexType name="GpDelegatedManagementDesKeySetType">
    <sequence>
      <element name="DelegatedManagementKey" type="ogpkf:GpDesEdeKeyType"/>
      <element name="ReceiptKey" type="ogpkf:GpDesEdeKeyType" minOccurs="0"/>
    </sequence>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
  </complexType>

  <complexType name="GpReceiptKeySetType">
    <sequence>
      <element name="ReceiptKey" type="ogpkf:GpDesEdeKeyType"/>
    </sequence>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
  </complexType>
  


  <complexType name="GpGenericKeySetType">
    <sequence>
      <element name="Key" type="ogpkf:GpGenericKeyType" maxOccurs="unbounded"/>
    </sequence>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
  </complexType>

  <complexType name="EtsiDesDapKeySetType">
    <sequence>
      <element name="DapKey" type="ogpkf:GpDesEdeKeyType"/>
    </sequence>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
  </complexType>

  <complexType name="OtaKeySetType">
    <sequence>
      <element name="CipherKey" type="ogpkf:OtaCipherKeyType"/>
      <element name="CheckKey" type="ogpkf:OtaCheckKeyType"/>
      <element name="DataEncryptionKey" type="ogpkf:OtaDataEncryptionKeyType" minOccurs="0"/>
      <element name="Spi" type="oct:EncodingHex2Byte"/>
      <element name="Tar" type="oct:EncodingHex3Byte" minOccurs="0"/>
      <element name="Counter" type="oct:EncodingHex5Byte" minOccurs="0"/>
      <element name="CcLength" type="oct:EncodingHexByte" minOccurs="0"/>
    </sequence>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
    <attribute name="Type" type="oct:AppletType" use="optional"/>
    <attribute name="KeyType" type="oct:EncodingHex1Byte" use="optional"/>
  </complexType>

  <complexType name="GpConfidentialLoadingKeySetType">
    <sequence>
      <element name="ConfidentialLoadingKey" type="ogpkf:GpDesEdeKeyType"/>
    </sequence>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
  </complexType>
  
  <complexType name="GpAesConfidentialLoadingKeySetType">
    <sequence>
      <element name="AesConfidentialLoadingKey" type="ogpkf:GpAesKeyType"/>
    </sequence>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
  </complexType>
  
  <complexType name="GpDataEncryptionKeySetType">
    <choice>
      <element name="DataEncryptionKey" type="ogpkf:GpDesAnyKeyType"/>
    </choice>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
  </complexType>

  <complexType name="GpAesDataEncryptionKeySetType">
    <choice>
      <element name="DataEncryptionKey" type="ogpkf:GpAesKeyType"/>
    </choice>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
  </complexType>
  
  <complexType name="GpPskTlsKeySetType">
    <choice>
      <element name="PskTlsKey" type="ogpkf:PskTlsKeySetType"/>
    </choice>
    <attributeGroup ref="ogpkf:GpKeySetAttributes"/>
    <attribute name="UniqueName" use="optional"/>
  </complexType> 
  
  <complexType name="PskTlsKeySetType">
    <complexContent>
      <extension base="ogpkf:GpSecretKeyType">
        <attribute name="CipherSuiteType" type="ogpkf:CipherSuiteType" use="required"/>
      </extension>
    </complexContent>
  </complexType> 
  
  <simpleType name="CipherSuiteType">
    <restriction base="string">
      <enumeration value="3DES_EDE_CBC_SHA" />
      <enumeration value="AES128_CBC_SHA" />
      <enumeration value="NULL_SHA" />
      <enumeration value="AES128_CBC_SHA256" />
      <enumeration value="NULL_SHA256" />
    </restriction>
  </simpleType>
  
  <!-- Global Platform key types -->

  <complexType name="GpDesAnyKeyType">
    <choice>
      <element name="DesKey" type="oct:DesKeyType"/>
      <element name="DesEdeKey" type="oct:DesEde2KeyType"/>
    </choice>
  </complexType>

  <complexType name="GpDesEdeKeyType">
    <sequence>
      <element name="DesEdeKey" type="oct:DesEde2KeyType"/>
    </sequence>
  </complexType>

  <complexType name="GpAesKeyType">
    <sequence>
      <element name="AesKey" type="oct:AesKeyType"/>
    </sequence>
  </complexType>
  
  <complexType name="GpSecretKeyType">
    <choice>
      <element name="AesKey" type="oct:AesKeyType"/>
      <element name="DesKey" type="oct:DesKeyType"/>
      <element name="DesEdeKey" type="oct:DesEdeKeyType"/>      
    </choice>
  </complexType>  

  <complexType name="VisaSecretKeyType">
    <complexContent>
      <extension base="ogpkf:GpSecretKeyType">
        <attribute name="KeyDivData" type="oct:EncodingHex10Byte" use="optional"/>
        <attribute name="Type" type="ogpkf:VisaMasterKeyTypeType" use="required"/>
      </extension>
    </complexContent>
  </complexType>
  
  <complexType name="DesDapVerificationKeyType">
    <complexContent>
      <extension base="ogpkf:GpDesEdeKeyType">
        <attribute name="Algorithm" type="ogpkf:DesDapVerificationAlgorithmType" use="required"/>
      </extension>
    </complexContent>
  </complexType>

  <complexType name="GpRsaKeyType">
    <choice>
      <element name="RsaPublicKey" type="ogpkf:RsaPublicKeyType" />
      <element name="RsaPrivateKey" type="ogpkf:RsaPrivateKeyType" />
      <element name="RsaKey" type="ogpkf:RsaKeyType" />
      <element name="RsaCrtKey" type="ogpkf:RsaCrtKeyType" />
    </choice>
  </complexType>

  <complexType name="GpGenericKeyType">
    <sequence>
      <element name="Component" type="ogpkf:GpGenericKeyComponentType" maxOccurs="unbounded"/>
    </sequence>
  </complexType>

  <complexType name="GpGenericKeyComponentType">
    <simpleContent>
      <extension base="oct:EncodingHexUnlimitedByte">
        <attribute name="TypeCoding" type="oct:EncodingHexByte" use="required"/>
      </extension>
    </simpleContent>
  </complexType>

  <complexType name="OtaCipherKeyType">
    <sequence>
      <element name="KeyValue" type="oct:DesAesKeyValueType"/>
    </sequence>
    <attribute name="Kic" type="oct:EncodingHexByte" use="required"/>
  </complexType>

  <complexType name="OtaCheckKeyType">
    <sequence>
      <element name="KeyValue" type="oct:DesAesKeyValueType"/>
    </sequence>
    <attribute name="Kid" type="oct:EncodingHexByte" use="required"/>
  </complexType>

  <complexType name="OtaDataEncryptionKeyType">
    <sequence>
      <element name="KeyValue" type="oct:DesAesKeyValueType"/>
    </sequence>
  </complexType>

  <!-- RSA key types -->

  <complexType name="RsaPublicKeyType">
    <sequence>
      <element name="Modulus" type="oct:EncodingHexUnlimitedByte"/>
      <element name="PublicExponent" type="oct:EncodingHexUnlimitedByte"/>
    </sequence>
    <attribute name="Name" type="string" use="optional"/>
  </complexType>

  <complexType name="RsaPrivateKeyType">
    <sequence>
      <element name="Modulus" type="oct:EncodingHexUnlimitedByte"/>
      <element name="PrivateExponent" type="oct:EncodingHexUnlimitedByte"/>
    </sequence>
    <attribute name="Name" type="string" use="optional"/>
  </complexType>

  <complexType name="RsaKeyType">
    <sequence>
      <element name="Modulus" type="oct:EncodingHexUnlimitedByte"/>
      <element name="PublicExponent" type="oct:EncodingHexUnlimitedByte"/>
      <element name="PrivateExponent" type="oct:EncodingHexUnlimitedByte"/>
    </sequence>
    <attribute name="Name" type="string" use="optional"/>
  </complexType>

  <!-- RsaCrtKey mandatory p, q, dp, dq -->
  <complexType name="RsaCrtMandatoryKeyType">
    <sequence>
      <element name="Modulus" type="oct:EncodingHexUnlimitedByte" minOccurs="0"/>
      <element name="PublicExponent" type="oct:EncodingHexUnlimitedByte" minOccurs="0"/>
      <element name="PrivateExponent" type="oct:EncodingHexUnlimitedByte" minOccurs="0"/>
      <element name="PrimeP" type="oct:EncodingHexUnlimitedByte"/>
      <element name="PrimeQ" type="oct:EncodingHexUnlimitedByte"/>
      <element name="PrimeExponentP" type="oct:EncodingHexUnlimitedByte"/>
      <element name="PrimeExponentQ" type="oct:EncodingHexUnlimitedByte"/>
      <element name="InverseP" type="oct:EncodingHexUnlimitedByte" minOccurs="0"/>
      <element name="InverseQ" type="oct:EncodingHexUnlimitedByte" minOccurs="0"/>
    </sequence>
    <attribute name="Name" type="string" use="optional"/>
  </complexType>

  <!-- RsaCrtKey all components optional -->
  <complexType name="RsaCrtKeyType">
    <sequence>
      <element name="Modulus" type="oct:EncodingHexUnlimitedByte" minOccurs="0"/>
      <element name="PublicExponent" type="oct:EncodingHexUnlimitedByte" minOccurs="0"/>
      <element name="PrivateExponent" type="oct:EncodingHexUnlimitedByte" minOccurs="0"/>
      <element name="PrimeP" type="oct:EncodingHexUnlimitedByte" minOccurs="0"/>
      <element name="PrimeQ" type="oct:EncodingHexUnlimitedByte" minOccurs="0"/>
      <element name="PrimeExponentP" type="oct:EncodingHexUnlimitedByte" minOccurs="0"/>
      <element name="PrimeExponentQ" type="oct:EncodingHexUnlimitedByte" minOccurs="0"/>
      <element name="InverseP" type="oct:EncodingHexUnlimitedByte" minOccurs="0"/>
      <element name="InverseQ" type="oct:EncodingHexUnlimitedByte" minOccurs="0"/>
    </sequence>
    <attribute name="Name" type="string" use="optional"/>
  </complexType>

  <!-- Attribute types -->

  <simpleType name="DapVerificationAlgorithmType">
    <restriction base="token">
      <enumeration value="DESede" />
      <enumeration value="DESretail" />
      <enumeration value="RSA" />
    </restriction>
  </simpleType>

  <simpleType name="DesDapVerificationAlgorithmType">
    <restriction base="token">
      <enumeration value="DESede" />
      <enumeration value="DESretail" />
    </restriction>
  </simpleType>

  <simpleType name="VisaMasterKeyTypeType">
    <restriction base="string">
      <enumeration value="ISK" />
      <enumeration value="KMC" />
      <enumeration value="CMK" />
      <enumeration value="CMK/xMK" />
    </restriction>
  </simpleType>
  
  <simpleType name="VisaMasterDerivationKeyTypeType">
    <restriction base="oct:EncodingHexByte">
      <enumeration value="80" />
      <enumeration value="88" />
    </restriction>
  </simpleType>
  
   <simpleType name="VisaMasterTransformationType">
    <restriction base="string">
      <enumeration value="DESede/ECB/NoPadding" />
      <enumeration value="AES/ECB/NoPadding" />
    </restriction>
  </simpleType>

  <attributeGroup name="GpKeySetAttributes">
    <attribute name="Version" type="oct:EncodingHex1Byte" default="00" use="optional"/>
    <attribute name="Identifier" type="oct:EncodingHex1Byte" default="00" use="optional"/>
    <attribute name="Aid" type="oct:EncodingAidHex" use="optional"/>
    <attribute name="Name" type="string" use="optional"/>
  </attributeGroup>

</schema>